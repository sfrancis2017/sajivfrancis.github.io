---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ChatLauncher from '@/components/ChatLauncher.astro';
import Search from '@/components/Search.astro';
import OwnerBadge from '@/components/OwnerBadge.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Tailwind max-width class for <main>. Defaults to `max-w-3xl` (prose width).
   * Pages that need more horizontal room (e.g. /lab/* tools) can pass `max-w-6xl` etc.
   */
  mainClass?: string;
  /**
   * Open Graph image path (absolute URL or root-relative). Defaults to the
   * site-wide social card so shares on LinkedIn / X always have a preview.
   * Per-post images can be passed in for richer previews.
   */
  ogImage?: string;
  /**
   * Article metadata (blog posts). When present the page is marked up as an
   * article for Google Discover / News surfaces: og:type=article,
   * article:published_time/modified_time, meta author, and BlogPosting
   * JSON-LD. ISO 8601 strings.
   */
  article?: { publishedTime: string; modifiedTime?: string };
}

const {
  title = 'Sajiv Francis',
  description = 'Enterprise Architect connecting business strategy to data, applications, technology, and AI — delivering measurable business outcomes.',
  mainClass = 'max-w-3xl',
  ogImage = '/img/og-default.png',
  article,
} = Astro.props;
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const fullTitle = title === 'Sajiv Francis' ? title : `${title} — Sajiv Francis`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// JSON-LD Person entity. Emitted site-wide so search/AI crawlers build a
// consistent identity graph for "Sajiv Francis" across every page.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sajiv Francis',
  url: 'https://sajivfrancis.com',
  jobTitle: 'Enterprise Architect',
  description:
    'Enterprise Architect connecting business strategy to data, applications, technology, and AI — delivering measurable business outcomes.',
  image: new URL('/img/og-default.png', Astro.site).toString(),
  sameAs: [
    'https://www.linkedin.com/in/sajiv-francis',
  ],
  knowsAbout: [
    'Enterprise Architecture',
    'Business Architecture',
    'Data Architecture',
    'Application Architecture',
    'Technology Architecture',
    'AI Architecture',
    'AI Governance',
    'SAP S/4HANA',
    'TOGAF',
    'Digital Transformation',
  ],
};

// BlogPosting structured data for article pages — the entity Google Discover
// and rich results read for headline, image (banners are 1600px wide,
// clearing Discover's 1200px large-image floor), dates, and authorship.
const articleJsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: [ogImageUrl],
      datePublished: article.publishedTime,
      dateModified: article.modifiedTime ?? article.publishedTime,
      author: {
        '@type': 'Person',
        name: 'Sajiv Francis',
        url: 'https://sajivfrancis.com/about/',
      },
      publisher: {
        '@type': 'Person',
        name: 'Sajiv Francis',
        url: 'https://sajivfrancis.com',
      },
      mainEntityOfPage: canonicalUrl,
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Allow large image previews in Google Search/Discover — required for
         Discover's large-card presentation of article banners. -->
    <meta name="robots" content="max-image-preview:large" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Person structured data (schema.org / JSON-LD) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personJsonLd)}
    />

    {
      articleJsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(articleJsonLd)}
        />
      )
    }

    <!-- Inter variable font -->
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta property="article:modified_time" content={article.modifiedTime ?? article.publishedTime} />
          <meta property="article:author" content="Sajiv Francis" />
          <meta name="author" content="Sajiv Francis" />
        </>
      )
    }
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{fullTitle}</title>

    <!-- Theme: read from cross-subdomain cookie first (so docs / chat /
         main stay in sync), fall back to localStorage, then to system
         preference. Set BEFORE paint to avoid a flash. Forward-syncs
         whichever source won so the next visit is fast. -->
    <script is:inline>
      (function () {
        const m = document.cookie.match(/(?:^|;\s*)theme=(light|dark)/);
        const cookieTheme = m ? m[1] : null;
        const localTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = cookieTheme || localTheme || (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        if (cookieTheme !== theme) {
          document.cookie =
            'theme=' + theme + '; Domain=.sajivfrancis.com; Path=/; Max-Age=31536000; SameSite=Lax; Secure';
        }
        if (localTheme !== theme) {
          try { localStorage.setItem('theme', theme); } catch (_) {}
        }
      })();
    </script>

    <!-- Owner-gated areas (/tools/*): hide page content before first paint
         unless an owner token is present. The Header's owner sync lifts the
         gate in the same page load after an SSO return. -->
    <script is:inline>
      (function () {
        if (!/^\/tools\//.test(location.pathname)) return;
        var owner = false;
        try {
          owner = !!(
            localStorage.getItem('write-token') ||
            localStorage.getItem('tools-access-token')
          );
        } catch (e) {}
        if (!owner) document.documentElement.classList.add('owner-gated-page');
      })();
    </script>
    <style is:inline>
      .owner-gated-page main { display: none; }
      .owner-gate-note { display: none; }
      .owner-gated-page .owner-gate-note {
        display: block;
        max-width: 28rem;
        margin: 6rem auto;
        padding: 0 1.5rem;
        text-align: center;
        color: var(--color-fg-muted);
      }
    </style>

    <!-- Analytics: GoatCounter (privacy-friendly, no cookies) -->
    <script
      is:inline
      data-goatcounter="https://sajivfrancis.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <div class="owner-gate-note">
      <p>This area is owner-only.</p>
      <p class="mt-2 text-sm">
        Sign in with the badge in the corner to continue, or head
        <a href="/" class="underline">back to the site</a>.
      </p>
    </div>
    <main class:list={['flex-1 w-full mx-auto px-6 py-12', mainClass]}>
      <slot />
    </main>
    <Footer />
    <Search />
    <!-- Owner-only: hidden by default, revealed by the Header's owner-nav
         sync when an owner token is present. -->
    <div class="owner-only hidden">
      <ChatLauncher />
    </div>
    <OwnerBadge />
    <!-- Newsletter subscribe widget (popup + inline). One worker-served script,
         identical on the main site and docs, so the UI stays uniform. -->
    <script src="https://chat.sajivfrancis.com/newsletter/widget.js" defer></script>
    <!-- Annotation layer (RecogitoJS). Self-skips unless the page has a
         [data-annotate] body (blog posts) — so it only loads where it's used. -->
    <script src="https://chat.sajivfrancis.com/annotations/widget.js" defer></script>
  </body>
</html>
