---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildPostUrl, formatDate } from '@/lib/utils';
import HeroVideo from '@/components/HeroVideo.astro';

// Phase 0 landing teaser — paste the CDN URL from the video pipeline here.
const heroVideo = 'https://sajiv-videos.sfo3.cdn.digitaloceanspaces.com/videos/sajivfrancis-com/1781500515279.mp4';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const shortDate = (d: Date) =>
  formatDate(d, { year: 'numeric', month: 'short', day: 'numeric' });

// Homepage sections. Outcome figures are verified facts stated
// employer-agnostically — nothing estimated.
const domains = [
  {
    name: 'Business',
    line: 'Capabilities, operating models, and transformation priorities — the problems architecture exists to serve.',
  },
  {
    name: 'Data',
    line: 'Governed platforms and AI-ready data that turn information into faster, trusted decisions.',
  },
  {
    name: 'Applications',
    line: 'ERP and enterprise application estates — S/4HANA transformation, integration, rationalization.',
  },
  {
    name: 'Technology',
    line: 'Cloud, platforms, and integration strategy with cost, resilience, and standards under control.',
  },
  {
    name: 'AI',
    line: 'Generative and agentic systems adopted with governance, observability, and measured economics.',
  },
];

const outcomes = [
  {
    metric: '5 → 3 days',
    label: 'month-end close after a general-ledger transformation',
  },
  {
    metric: '30–40%',
    label: 'faster delivery through cross-functional flash teams, without added headcount',
  },
  {
    metric: '10K+ users',
    label: 'served by a governed enterprise analytics platform',
  },
  {
    metric: '−35%',
    label: 'critical-incident resolution time under post-go-live governance',
  },
  {
    metric: 'Token ROI',
    label: 'AI economics reported at executive level — LLM observability tied to TCO',
  },
];
---

<BaseLayout
  title="Sajiv Francis"
  description="Enterprise Architect connecting business strategy to data, applications, technology, and AI — delivering measurable business outcomes."
>
  <HeroVideo src={heroVideo} class="mb-8" />

  <section class="space-y-6">
    <p class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)]">
      Enterprise Architecture
    </p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.1]">
      Sajiv Francis
    </h1>
    <p class="text-lg leading-relaxed text-[var(--color-fg-muted)]">
      Enterprise Architect — connecting business strategy to data,
      applications, technology, and AI to deliver measurable business
      outcomes. Currently leading architecture across a Fortune 100
      multi-instance S/4HANA finance transformation and four enterprise AI
      programs, governed end to end.
    </p>
    <p class="text-base text-[var(--color-fg-muted)]">
      TOGAF 10 · Stanford AI-Driven Leadership · Columbia Applied Data
      Science
    </p>
  </section>

  <section class="mt-16 pt-12 border-t border-[var(--color-border)]">
    <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-3">
      Architecture at Enterprise Scale
    </h2>
    <p class="text-[var(--color-fg-muted)] mb-8">
      The value isn't in any one domain — it's in the connections: knowing
      how a change in one propagates through the others.
    </p>
    <ul class="space-y-5">
      {domains.map((d) => (
        <li>
          <span class="font-medium text-[var(--color-fg)]">{d.name}</span>
          <p class="text-sm text-[var(--color-fg-muted)] mt-1">{d.line}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16 pt-12 border-t border-[var(--color-border)]">
    <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-6">
      What Architecture Makes Possible
    </h2>
    <ul class="space-y-4">
      {outcomes.map((o) => (
        <li class="flex items-baseline gap-4">
          <span class="font-semibold text-[var(--color-fg)] tabular-nums shrink-0 w-28">
            {o.metric}
          </span>
          <span class="text-[var(--color-fg-muted)]">{o.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16 pt-12 border-t border-[var(--color-border)]">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)]">
        Recent Writing
      </h2>
      <a href="/blog/" class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">
        Archive →
      </a>
    </div>
    {
      posts.length === 0 ? (
        <p class="text-[var(--color-fg-muted)]">Posts coming soon.</p>
      ) : (
        <ul class="space-y-5">
          {posts.map((post) => (
            <li class="flex items-baseline justify-between gap-4">
              <a
                href={buildPostUrl(post)}
                class="text-[var(--color-fg)] no-underline hover:underline truncate"
              >
                {post.data.title}
              </a>
              <time class="text-sm text-[var(--color-fg-subtle)] tabular-nums shrink-0">
                {shortDate(post.data.pubDate)}
              </time>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="mt-16 pt-12 border-t border-[var(--color-border)]">
    <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-3">
      Subscriber Access
    </h2>
    <p class="text-[var(--color-fg-muted)] mb-4">
      Subscribing is free and unlocks the working side of this site: new
      writing by email, full access to the
      <a href="https://docs.sajivfrancis.com/">field-notes library</a>, and the
      <a href="https://chat.sajivfrancis.com/">research chat</a> — a grounded
      assistant over my published work.
    </p>
    <p>
      <a
        href="/subscribe/"
        class="text-[var(--color-fg)] underline hover:no-underline"
      >
        Subscribe →
      </a>
    </p>
  </section>

  <section class="mt-16 pt-12 border-t border-[var(--color-border)]">
    <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-6">
      Find Me
    </h2>
    <ul class="space-y-2 text-[var(--color-fg-muted)]">
      <li>
        <a
          href="https://www.linkedin.com/in/sajiv-francis"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
      </li>
      <li>
        <a href="mailto:admin@sajivfrancis.com">Email</a>
      </li>
    </ul>
  </section>
</BaseLayout>
