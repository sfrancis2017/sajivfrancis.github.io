---
// Companion stage — plan 10 steps 2–4. One screen: a question in (voice or
// typed), a SCENE out (layout + data + narration), rendered by the portable
// renderer in /lab/stage/lib/stage-render.js; the avatar (lab modules) sits
// in its seat beside the scene (avatar-presence.js; moving to the narrated
// element is PARKED per plan 10 Amendment B — `?move=1` re-enables it) while
// the narration player speaks line by line (narration-player.js → TTS route, or silent
// timing without a token). Voice in = voice-input.js (Web Speech or VAD + the
// worker's STT route); every turn is timed from end of speech by
// stage-metrics.js (plan 10 §8). Owner-gated like every /tools/* page.
// Demo mode (?demo=1) plays the saved sample scenes without calling the API.
import BaseLayout from '@/layouts/BaseLayout.astro';
const STAGE_ENDPOINT = 'https://chat-worker.sfrancis2017.workers.dev/api/stage/turn';
const TTS_ENDPOINT = 'https://chat-worker.sfrancis2017.workers.dev/api/voice/tts';
const STT_ENDPOINT = 'https://chat-worker.sfrancis2017.workers.dev/api/voice/stt';
const SAMPLES_URL = '/lab/stage/samples/index.json';
const MODEL_URL = '/lab/avatar/model.glb';
---
<BaseLayout
  title="Companion Stage"
  description="Owner-only prototype: ask the library and get a scene — a layout, the data, and the narration an avatar will speak. Test bed for the Gravitite stage."
  mainClass="max-w-6xl"
>
  <script type="importmap" is:inline>
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
      }
    }
  </script>

  <article class="container">
    <header class="tool-header">
      <div class="title">
        <h1>Companion Stage</h1>
        <div class="subtitle">Ask the library. Each answer is a scene: a layout, the data, and the lines the avatar speaks beside it.</div>
      </div>
      <a class="back-link" href="/tools/">All tools</a>
    </header>

    <div id="auth" class="muted small"></div>

    <form id="ask" class="ask">
      <input id="q" type="text" placeholder="e.g. How many articles and series are in the library?" autocomplete="off" />
      <button id="send" class="primary" type="submit">Ask</button>
      <button id="mic" type="button" title="Voice: listen for questions (toggle)">🎤 Voice</button>
      <select id="engine" title="Speech recognition engine">
        <option value="webspeech">Web Speech</option>
        <option value="vad">VAD + STT route</option>
      </select>
      <span id="vstate" class="pill" data-state="off">off</span>
      <button id="back" type="button" title="Previous scene" disabled>← Back</button>
      <button id="demo" type="button" title="Play the saved sample scenes">Samples</button>
      <button id="narrate" type="button" title="Narrate this scene" disabled>▶ Narrate</button>
      <button id="stop" type="button" title="Stop narration" disabled>■</button>
      <label class="check"><input id="auto" type="checkbox" checked /> Auto-narrate</label>
      <!-- Mode (plan 12 §3): the stage's sticky mode. The classifier may propose
           the other mode and the page announces it; clicking a mode PINS it
           (manual override); clicking the pinned mode again returns to auto. -->
      <span id="mode-switch" class="mode-switch" role="group" aria-label="Mode" data-mode="lookup" data-pinned="0">
        <button type="button" class="mode" data-mode="lookup" title="Find, summarise, list what is published">Lookup</button>
        <button type="button" class="mode" data-mode="solutioning" title="Apply a scenario to a standard architecture; options, position">Solutioning</button>
        <span id="mode-pin" class="pin" title="Pinned: the classifier may not switch modes" hidden>📌</span>
      </span>
    </form>

    <section id="stage" class="stage" data-slot="side" data-size="m">
      <div class="stage-title">
        <h2 id="scene-title">Ready</h2>
        <span id="scene-layout" class="chip"></span>
        <span id="scene-mode" class="chip mode-chip" hidden></span>
      </div>
      <div class="stage-body">
        <div id="layout" class="layout" aria-live="polite"></div>
        <div id="avatar-home" class="avatar-home" aria-hidden="true"></div>
      </div>
      <div id="actions" class="actions"></div>
      <div id="followups" class="followups"></div>
      <!-- Sources strip (plan 12 §4): library pages as links; vector-store
           passages as topic chips ("SAP vector store") — never a title. -->
      <div id="sources" class="sources" hidden></div>
      <div id="avatar-layer" class="avatar-layer" aria-hidden="true"><div class="avatar-fallback" id="avatar-fallback">…</div></div>
    </section>

    <section class="panel track">
      <div class="track-head"><h3>Text track</h3><span id="status" class="muted small"></span></div>
      <ol id="narration" class="narration"></ol>
    </section>

    <section class="panel measure">
      <h3>Measurements (this turn)</h3>
      <dl class="kv">
        <dt>Speech → transcript (STT)</dt><dd id="m-stt">—</dd>
        <dt>Speech → audible (filler / line 1)</dt><dd id="m-audible">—</dd>
        <dt>Speech → scene on screen</dt><dd id="m-scene">—</dd>
        <dt>Turn (client / worker)</dt><dd id="m-turn">—</dd>
        <dt>Model / tools / first line</dt><dd id="m-split">—</dd>
        <dt>Tool calls</dt><dd id="m-tools">—</dd>
        <dt>Tokens in / out / cached</dt><dd id="m-tok">—</dd>
        <dt>Est. cost (model)</dt><dd id="m-cost">—</dd>
        <dt>TTS first byte (line 1 / avg)</dt><dd id="m-tts">—</dd>
        <dt>Narration total</dt><dd id="m-narr">—</dd>
        <dt>Avatar</dt><dd id="m-avatar">—</dd>
        <dt>Scenes this session</dt><dd id="m-count">0</dd>
      </dl>
    </section>

    <section class="panel harness">
      <div class="track-head">
        <h3>Turn log (plan 10 §8)</h3>
        <span class="row-btns"><button id="csv" type="button" class="small-btn">Export CSV</button><button id="clear-log" type="button" class="small-btn">Clear</button></span>
      </div>
      <p id="log-summary" class="muted small"></p>
      <div class="scroll-x"><table id="turn-log" class="turn-log"></table></div>
    </section>
    <audio id="audio" preload="auto"></audio>
  </article>

  <script type="module" is:inline define:vars={{ STAGE_ENDPOINT, TTS_ENDPOINT, STT_ENDPOINT, SAMPLES_URL, MODEL_URL }}>
    import { renderScene, STAGE_CSS } from '/lab/stage/lib/stage-render.js';
    import { createPresence, PRESENCE_CSS } from '/lab/stage/lib/avatar-presence.js';
    import { createNarrationPlayer } from '/lab/stage/lib/narration-player.js';
    import { createVoiceInput, WEBSPEECH_SUPPORTED } from '/lab/stage/lib/voice-input.js';
    import { createTurnLog, METRICS_CSS } from '/lab/stage/lib/stage-metrics.js';
    const $ = (id) => document.getElementById(id);
    const style = document.createElement('style'); style.textContent = STAGE_CSS + PRESENCE_CSS + METRICS_CSS; document.head.appendChild(style);
    const now = () => performance.now();

    // ---- owner token (same key + SSO handoff as the other tools) -------------
    const TOKEN_KEY = 'write-token';
    const SSO_HANDOFF = 'https://chat.sajivfrancis.com/admin/api/sso-handoff';
    (function consumeHandoff() {
      const m = (location.hash || '').match(/(?:^#|&)owner-token=([^&]+)/);
      if (!m) return;
      try { localStorage.setItem(TOKEN_KEY, decodeURIComponent(m[1])); } catch {}
      history.replaceState(null, '', location.pathname + location.search);
    })();
    const getToken = () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } };
    const params = new URLSearchParams(location.search);
    const apiBase = params.get('api') ? params.get('api').replace(/\/$/, '') : null;
    const endpoint = apiBase ? `${apiBase}/api/stage/turn` : STAGE_ENDPOINT;
    const ttsEndpoint = apiBase ? `${apiBase}/api/voice/tts` : TTS_ENDPOINT;
    const sttEndpoint = apiBase ? `${apiBase}/api/voice/stt` : STT_ENDPOINT;
    const silent = params.get('silent') === '1' || !getToken();
    const moveAvatar = params.get('move') === '1'; // Amendment B: seated by default
    // TTS voice follows the avatar's gender (founder, 2026-11-11): this test avatar
    // is male → Grok "leo"; a female avatar later → "ara". `?tts=<id>` overrides.
    const ttsVoice = params.get('tts') || 'leo';
    if (!getToken()) {
      $('auth').innerHTML = 'Asking and speech need the owner token. <a href="#" id="sso">Sign in with Access</a> — or press Samples: layouts render and the avatar moves in silent mode.';
      $('sso').addEventListener('click', (e) => { e.preventDefault(); location.href = SSO_HANDOFF + '?redirect=' + encodeURIComponent(location.href); });
    }

    // ---- avatar: presence now, 3D lazily --------------------------------------
    const presence = createPresence($('avatar-layer'), $('stage'), { home: $('avatar-home') });
    let avatar3d = null; // { stage, avatar, idle, lips }
    async function ensureAvatar() {
      if (avatar3d !== null) return avatar3d;
      avatar3d = false; // loading / failed sentinel
      const t0 = now();
      try {
        const [{ loadAvatar }, { createStage }, { createIdle }, { createLipsync }] = await Promise.all([
          import('/lab/avatar/lib/avatar-loader.js'), import('/lab/avatar/lib/avatar-stage.js'), import('/lab/avatar/lib/avatar-idle.js'), import('/lab/avatar/lib/avatar-lipsync.js'),
        ]);
        const { createTalk } = await import('/lab/avatar/lib/avatar-talk.js'); // talking motion (plan 11 v2): sway/nods with the voice, brows, glances at the scene
        const holder = $('avatar-layer');
        const st = createStage(holder, { transparent: true, controls: false, pixelRatioCap: 1.5 });
        const av = await loadAvatar(MODEL_URL);
        st.add(av.root); st.frameHead(av, { distance: 0.95, lift: 0.015, lookDown: 0.03 });
        const idle = createIdle(av); const lips = createLipsync(av, { gain: 2.2 }); lips.attach($('audio'));
        const talk = createTalk(av, lips, { glanceDir: -1, glanceYawDeg: 6 }); // the scene sits to the avatar's left
        st.onTick((dt, t) => { idle.tick(dt, t); lips.tick(dt); talk.tick(dt, t); }); st.start();
        $('avatar-fallback').remove();
        avatar3d = { stage: st, avatar: av, idle, lips, talk };
        $('m-avatar').textContent = `3D ready in ${Math.round(now() - t0)} ms · ${av.stats.morphCount} targets`;
      } catch (err) {
        console.warn('avatar 3D unavailable, using fallback', err);
        $('avatar-fallback').textContent = 'SF';
        $('m-avatar').textContent = `fallback (${err?.message ?? 'no WebGL'})`;
        avatar3d = false;
      }
      presence.update();
      return avatar3d;
    }

    // ---- speech out: TTS client, filler phrases, narration player -----------------
    const { createVoiceClient } = await import('/lab/avatar/lib/voice-client.js');
    const voice = createVoiceClient({ endpoint: ttsEndpoint, getToken });
    const audioEl = $('audio');
    // Filler lines, prefetched once, so something is audible within the §8
    // budget while the model works. Rotated so repeats are rare.
    const ACKS = ['Let me look.', 'One moment.', 'Checking the library.', 'Let me check that.'];
    const LATE = 'Still searching the library.';          // spoken once if the first line is slow (multi-step turns)
    const LATE_AFTER_MS = 7000;
    const LOST = 'Sorry, I lost the connection. Ask me again.';
    // Mode announcements (plan 12 §3): spoken when the classifier switched the
    // mode the page asked for — so the switch is never silent.
    const MODE_ANNOUNCE = { solutioning: 'Treating this as a scenario.', lookup: 'Looking that up.' };
    const ackCache = new Map(); let ackIdx = 0; let acksLoading = null;
    function prefetchAcks() {
      if (silent || acksLoading) return acksLoading;
      acksLoading = Promise.all([...ACKS, LATE, LOST, ...Object.values(MODE_ANNOUNCE)].map((t) => voice.speak(t, { voice: ttsVoice }).then((r) => ackCache.set(t, r.audioUrl)).catch((e) => console.warn('ack prefetch failed', e))));
      return acksLoading;
    }
    // Play a filler after whatever is audible now ends (or at once when nothing is).
    function queueFiller(t, stillWanted = () => true) {
      if (silent) return;
      fillerDone = fillerDone.then(() => { if (stillWanted()) playFiller(t); return fillerDone; });
    }

    // ---- mode (plan 12 §3): sticky per session, classifier may propose, user may pin ----
    const MODE_KEY = 'stage-mode';
    let sessionMode = 'lookup', modePinned = false, lastQuestion = '';
    try { const saved = JSON.parse(localStorage.getItem(MODE_KEY) || 'null'); if (saved && ['lookup', 'solutioning'].includes(saved.mode)) { sessionMode = saved.mode; modePinned = !!saved.pinned; } } catch {}
    if (['lookup', 'solutioning'].includes(params.get('mode'))) { sessionMode = params.get('mode'); modePinned = true; }
    function renderMode() {
      const sw = $('mode-switch'); sw.dataset.mode = sessionMode; sw.dataset.pinned = modePinned ? '1' : '0';
      sw.querySelectorAll('.mode').forEach((b) => b.classList.toggle('on', b.dataset.mode === sessionMode));
      $('mode-pin').hidden = !modePinned;
      try { localStorage.setItem(MODE_KEY, JSON.stringify({ mode: sessionMode, pinned: modePinned })); } catch {}
    }
    function setMode(mode, { pinned = modePinned } = {}) { sessionMode = mode; modePinned = pinned; renderMode(); }
    $('mode-switch').querySelectorAll('.mode').forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.mode;
      if (m === sessionMode && modePinned) setMode(m, { pinned: false });  // second click on the pinned mode → auto
      else setMode(m, { pinned: true });                                   // a click is the manual override
      $('status').textContent = `Mode: ${sessionMode}${modePinned ? ' (pinned)' : ' (auto)'}`;
    }));
    renderMode();
    // Spoken/typed corrections: flip the mode and re-ask the last question —
    // no model call for the phrase itself (plan 12 §3).
    const CORRECTIONS = [
      [/^(?:no[, ]+)?(?:just |please )?(?:look (?:it|that|this) up|look up(?: the data)?|only the (?:library|facts))\.?$/i, 'lookup'],
      [/^(?:no[, ]+)?(?:treat|take) (?:this|that|it) as a scenario\.?$|^(?:make|as) (?:it |this )?a scenario\.?$|^(?:solution|scenario) mode\.?$/i, 'solutioning'],
    ];
    function correction(text) {
      const t = String(text || '').trim();
      for (const [re, mode] of CORRECTIONS) if (re.test(t)) return mode;
      return null;
    }
    function applyCorrection(mode, meta) {
      setMode(mode, { pinned: true });
      if (!lastQuestion) { $('status').textContent = `Mode: ${mode} (pinned) — ask a question.`; return true; }
      $('status').textContent = `Mode: ${mode} (pinned) — asking again…`;
      ask(lastQuestion, { ...meta, correction: mode });
      return true;
    }
    // Audible marks: the next 'playing' event on the audio element stamps the
    // pending mark on the current turn record (ack_ms / line1_ms from speech end).
    let pendingMark = null;
    audioEl.addEventListener('playing', () => { if (pendingMark && turn) mark(pendingMark); pendingMark = null; });
    function mark(k) { if (!turn || turn.rec[k] != null) return; turn.rec[k] = Math.round(now() - turn.t0); updateTurnPanel(); }
    // `fillerDone` resolves when the filler now audible ends (or is cut), so
    // queued fillers and the streamed first line play strictly one after another.
    let fillerDone = Promise.resolve();
    function playFiller(t) {
      const url = ackCache.get(t);
      if (!url) return false;
      player.stop(); pendingMark = 'ack_ms'; remember(t);
      fillerDone = new Promise((res) => {
        const done = () => { for (const e of ['ended', 'pause', 'error', 'emptied']) audioEl.removeEventListener(e, done); res(); };
        for (const e of ['ended', 'pause', 'error', 'emptied']) audioEl.addEventListener(e, done);
      });
      audioEl.src = url; audioEl.play().catch(() => { pendingMark = null; });
      return true;
    }
    const playAck = () => playFiller(ACKS[ackIdx++ % ACKS.length]);
    const spoken = []; // last few spoken texts — echo guard for Web Speech
    const remember = (t) => { if (!t || spoken.includes(t)) return; spoken.push(t); if (spoken.length > 16) spoken.shift(); };
    const ttfbs = []; let lineOffset = 0;
    const player = createNarrationPlayer({
      audioEl,
      speak: silent ? null : (text) => voice.speak(text, { voice: ttsVoice }),
      onLineStart: (i, line) => { setLine(i + lineOffset); remember(line.text); if (i + lineOffset === 0) { if (silent) mark('line1_ms'); else pendingMark = 'line1_ms'; } },
      onLineEnd: (i) => { if (i + lineOffset === 0 && pendingMark === 'line1_ms') pendingMark = null; },
      onMetrics: (m) => { if (m.ttfbMs != null) { ttfbs.push(m.ttfbMs); $('m-tts').textContent = `${ttfbs[0]} / ${Math.round(ttfbs.reduce((a, b) => a + b, 0) / ttfbs.length)} ms (${m.provider})`; if (turn && turn.rec.tts_ttfb_ms == null) turn.rec.tts_ttfb_ms = m.ttfbMs; } if (m.error) $('status').textContent = `TTS: ${m.error}`; },
      onEnd: () => { $('m-narr').textContent = `${Math.round(now() - narrT0)} ms${silent ? ' (silent timing)' : ''}`; $('status').textContent = 'Narration done.'; $('narrate').disabled = false; $('stop').disabled = true; presence.moveTo(null); finishTurn(); },
    });
    let narrT0 = 0;
    // Speak a scene's lines from `from`; the first played line may carry
    // pre-fetched audio (the streamed first line).
    function narrate(scene, { from = 0, firstAudio = null } = {}) {
      player.stop();
      if (from === 0) { ttfbs.length = 0; narrT0 = now(); }
      $('narrate').disabled = true; $('stop').disabled = false; $('status').textContent = silent ? 'Narrating (silent mode)…' : 'Narrating…';
      ensureAvatar();
      lineOffset = from;
      const lines = scene.narration.slice(from).map((l, i) => (i === 0 && firstAudio ? { ...l, audio: firstAudio } : l));
      return player.play(lines);
    }
    $('narrate').addEventListener('click', () => { const e = scenes[scenes.length - 1]; if (e) { narrT0 = now(); narrate(e.scene); } });
    $('stop').addEventListener('click', () => stopSpeaking('Stopped.'));
    function stopSpeaking(msg) { player.stop(); pendingMark = null; try { audioEl.pause(); } catch {} if (msg) $('status').textContent = msg; $('narrate').disabled = false; $('stop').disabled = true; }

    // ---- state -----------------------------------------------------------------
    const PRICE = { 'claude-opus-5-5': [4, 20, 0.2], 'claude-sonnet-5-5': [2, 10, 0.2] };
    const scenes = []; // history of { question, scene, timings, usage, model }
    let view = null;

    function showScene(entry, { keepPlaying = false } = {}) {
      if (!keepPlaying) player.stop();
      ensureAvatar(); // 3D loads on the first scene (lazy, non-blocking)
      const s = entry.scene;
      $('scene-title').textContent = s.title;
      $('scene-layout').textContent = s.layout;
      const modeChip = $('scene-mode'); modeChip.hidden = !s.mode; modeChip.textContent = s.mode || ''; modeChip.dataset.mode = s.mode || '';
      view = renderScene($('layout'), s);
      const stage = $('stage');
      stage.dataset.slot = s.avatar?.slot || 'side'; stage.dataset.size = s.avatar?.size || 'm';
      presence.setSize(s.avatar?.size || 'm');
      if (!keepPlaying) presence.moveTo(null);
      $('narration').innerHTML = '';
      s.narration.forEach((n) => remember(n.text)); // every upcoming line counts as "my own voice" for the echo guard
      // Registers (plan 12): evidence lines carry a small marker with their
      // citations; inference lines render in the "my read" style.
      s.narration.forEach((n, i) => {
        const li = document.createElement('li'); li.textContent = n.text; li.dataset.focus = n.focus || '';
        if (n.register) { li.dataset.register = n.register; li.classList.add(n.register); }
        if (Array.isArray(n.cites) && n.cites.length) { const c = document.createElement('small'); c.className = 'cites'; c.textContent = n.cites.join(' '); c.title = 'Evidence cited'; li.appendChild(c); }
        li.addEventListener('click', () => { stopSpeaking(null); setLine(i); });
        $('narration').appendChild(li);
      });
      const src = $('sources'); src.innerHTML = '';
      const ev = Array.isArray(s.evidence) ? s.evidence : [];
      src.hidden = ev.length === 0;
      if (ev.length) {
        const lab = document.createElement('span'); lab.className = 'src-label'; lab.textContent = 'Sources'; src.appendChild(lab);
        const seenLabel = new Set();
        for (const e of ev) {
          if (e.kind === 'library') { const a = document.createElement(e.url ? 'a' : 'span'); a.className = 'src lib'; a.textContent = e.title || e.id; if (e.url) { a.href = e.url; a.target = '_blank'; a.rel = 'noopener'; } a.title = e.id; src.appendChild(a); }
          else { const label = e.label || 'vector store'; if (seenLabel.has(label)) continue; seenLabel.add(label); const sp = document.createElement('span'); sp.className = 'src vs'; sp.textContent = label; sp.title = ev.filter((x) => x.kind === 'vector' && (x.label || 'vector store') === label).map((x) => x.id).join(' '); src.appendChild(sp); }
        }
      }
      $('actions').innerHTML = '';
      for (const a of s.actions || []) {
        const b = document.createElement(a.kind === 'pivot' ? 'a' : 'button');
        b.className = 'action'; b.textContent = a.label;
        if (a.kind === 'pivot') { b.href = a.target; b.target = '_blank'; b.rel = 'noopener'; }
        else b.addEventListener('click', () => ask(a.target));
        $('actions').appendChild(b);
      }
      $('followups').innerHTML = '';
      for (const f of s.follow_ups || []) { const b = document.createElement('button'); b.className = 'chip-btn'; b.textContent = f; b.addEventListener('click', () => ask(f)); $('followups').appendChild(b); }
      $('back').disabled = scenes.length < 2;
      $('narrate').disabled = false; $('stop').disabled = true;
      if (entry.timings) {
        $('m-turn').textContent = `${entry.clientMs ?? entry.timings.total_ms} / ${entry.timings.total_ms} ms`;
        $('m-split').textContent = `${entry.timings.model_ms} / ${entry.timings.tool_ms} / ${entry.timings.first_line_ms ?? '—'} ms · ${entry.timings.steps} steps`;
        $('m-tools').textContent = (entry.tool_calls || []).map((t) => t.name + (t.ok ? '' : ' ✗')).join(', ') || '—';
        const u = entry.usage || {}; $('m-tok').textContent = `${u.input ?? 0} / ${u.output ?? 0} / ${u.cache_read ?? 0}`;
        $('m-cost').textContent = `$${costOf(entry).toFixed(4)}`;
      }
      $('m-count').textContent = String(scenes.length);
      $('m-tts').textContent = '—'; $('m-narr').textContent = '—';
      if (!keepPlaying) { if ($('auto').checked) { narrT0 = now(); narrate(s); } else setLine(0); }
    }
    function costOf(entry) { const u = entry.usage || {}; const p = PRICE[entry.model] || PRICE['claude-opus-5-5']; return ((u.input ?? 0) * p[0] + (u.output ?? 0) * p[1] + (u.cache_read ?? 0) * p[2]) / 1e6; }
    function setLine(i) {
      const lis = [...$('narration').children];
      lis.forEach((li, j) => li.classList.toggle('current', j === i));
      const focus = lis[i]?.dataset.focus || '';
      const el = view?.focus(focus || null) || null;
      const anchor = el && el.ownerSVGElement ? (el.closest('svg') || el) : el; // SVG parts anchor to the chart
      presence.moveTo(moveAvatar ? anchor : null);
      $('status').textContent = focus ? `line ${i + 1} → ${focus}${el ? '' : ' (not on screen)'}` : `line ${i + 1}`;
    }

    // ---- the turn: question → (streamed first line) → scene -----------------------
    // Reads the SSE form of /api/stage/turn (status / line / scene / error);
    // falls back to plain JSON if the worker answers that way.
    async function fetchTurn(question, { signal, onLine, onStatus, onMode } = {}) {
      const history = scenes.slice(-6).map((e) => ({ question: e.question, title: e.scene.title, layout: e.scene.layout }));
      const r = await fetch(endpoint, { method: 'POST', signal, headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream', Authorization: `Bearer ${getToken()}` }, body: JSON.stringify({ question, history, mode: sessionMode, mode_pinned: modePinned }) });
      if (!(r.headers.get('content-type') || '').includes('text/event-stream')) { const body = await r.json(); return { status: r.status, body }; }
      const reader = r.body.getReader(); const dec = new TextDecoder(); let buf = '';
      let final = null;
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        let i;
        while ((i = buf.indexOf('\n\n')) >= 0) {
          const chunk = buf.slice(0, i); buf = buf.slice(i + 2);
          const ev = (chunk.match(/^event:\s*(.*)$/m) || [])[1]; const data = chunk.split('\n').filter((l) => l.startsWith('data:')).map((l) => l.slice(5).trim()).join('');
          if (!ev || !data) continue;
          const d = JSON.parse(data);
          if (ev === 'status') onStatus?.(d.text, d.at_ms);
          else if (ev === 'mode') onMode?.(d);
          else if (ev === 'line') onLine?.(d.text, d.at_ms);
          else if (ev === 'scene' || ev === 'error') final = { status: d.status ?? (ev === 'scene' ? 200 : 502), body: d };
        }
      }
      return final || { status: 502, body: { error: 'stream ended without a scene' } };
    }

    let turn = null; // in-flight turn: { t0, rec, abort, early, earlyPlay, logged }
    function updateTurnPanel() {
      if (!turn) return; const r = turn.rec;
      $('m-stt').textContent = r.stt_ms != null ? `${r.stt_ms} ms (${r.stt_backend || r.engine})` : '—';
      const aud = [r.ack_ms != null ? `filler ${r.ack_ms}` : null, r.line1_ms != null ? `line 1 ${r.line1_ms}` : null].filter(Boolean).join(' · ');
      $('m-audible').textContent = aud ? `${aud} ms` : '—';
      $('m-scene').textContent = r.scene_ms != null ? `${r.scene_ms} ms` : '—';
      if (turn.logged) turn.logged = log.update(turn.logged, r);
    }
    function finishTurn() { if (!turn) return; turn.logged = turn.logged ? log.update(turn.logged, turn.rec) : log.add(turn.rec); log.render($('turn-log'), $('log-summary')); }

    // question → scene, timed from `speechEndAt` (end of speech, or the click)
    async function ask(question, meta = {}) {
      question = String(question || '').trim(); if (!question) return;
      if (!getToken()) { $('status').textContent = 'Sign in first (owner token).'; return; }
      // A correction phrase is not a question: flip the mode, re-ask the last one.
      if (!meta.correction) { const m = correction(question); if (m) { stopSpeaking(null); applyCorrection(m, meta); return; } }
      lastQuestion = question;
      if (turn) { if (turn.rec.scene_ms == null && !turn.rec.error) { turn.rec.valid = false; turn.rec.error = 'aborted'; } turn.abort.abort(); finishTurn(); }
      const t0 = meta.speechEndAt ?? now();
      const rec = { question, engine: meta.engine ?? 'typed', stt_backend: meta.backend ?? '', stt_ms: meta.sttMs ?? null, ts: new Date().toISOString(), mode: sessionMode, mode_pinned: modePinned, corrected: meta.correction || '' };
      const my = turn = { t0, rec, abort: new AbortController(), early: null, earlyPlay: null, logged: null };
      $('send').disabled = true; $('status').textContent = 'Thinking…'; $('q').value = question;
      stopSpeaking(null); updateTurnPanel();
      ensureAvatar();
      if (!silent) playAck();
      // A slow first line (tool round-trips) gets one more spoken filler so the
      // silence never reads as a dead turn.
      let lateTimer = silent ? null : setTimeout(() => { if (turn === my && !my.early && !speaking()) playFiller(LATE); }, LATE_AFTER_MS);
      const tFetch = now();
      try {
        const opts = {
          signal: my.abort.signal,
          onStatus: (text) => { if (turn === my) $('status').textContent = `Thinking… (${text})`; },
          // Grounding done: the worker tells us the mode it runs in. A switch
          // the page did not ask for is announced (after the filler) and
          // becomes the sticky mode; a pinned mode is never switched.
          onMode: (d) => {
            if (turn !== my) return;
            rec.mode = d.mode; rec.mode_suggested = d.suggested || ''; rec.evidence_lib = d.lib; rec.evidence_vs = d.vs;
            if (d.mode !== sessionMode && !modePinned) { setMode(d.mode); rec.mode_switched = true; queueFiller(MODE_ANNOUNCE[d.mode], () => turn === my); $('status').textContent = `Thinking… (${d.mode}: ${MODE_ANNOUNCE[d.mode]})`; }
          },
          onLine: (text, atMs) => {
            if (turn !== my || my.early) return;
            clearTimeout(lateTimer);
            my.early = { text, atMs, audio: silent ? null : voice.speak(text, { voice: ttsVoice }) }; // TTS starts now, before the data
            rec.first_line_worker_ms = atMs;
            $('narration').innerHTML = `<li class="current early">${text.replace(/</g, '&lt;')}</li>`;
            $('status').textContent = 'First line in — speaking while the data arrives…';
            if (silent) { mark('line1_ms'); return; }
            const start = () => { if (turn !== my) return; narrT0 = now(); lineOffset = 0; my.earlyPlay = player.play([{ id: 'early', text, focus: null, audio: my.early.audio }]); };
            my.early.audio.then(() => {
              if (turn !== my) return;
              fillerDone.then(() => { if (turn === my) start(); }); // let the filler (and a queued mode announcement) finish
            }).catch(() => { my.early.failed = true; my.earlyPlay = Promise.resolve(true); }); // TTS failed → the full narration speaks it
          },
        };
        // One retry on a network failure ("Failed to fetch": CORS-less edge error,
        // dropped connection) — seen once in the founder's 2026-11-12 run.
        const out = await fetchTurn(question, opts).catch((e) => {
          if (e?.name === 'AbortError' || turn !== my || my.early) throw e;
          rec.retried = true; $('status').textContent = `Connection dropped (${e?.message ?? e}) — retrying…`;
          return fetchTurn(question, opts);
        });
        clearTimeout(lateTimer);
        if (turn !== my) return;
        const body = out.body;
        rec.turn_ms = Math.round(now() - tFetch);
        if (out.status !== 200 || !body.scene) {
          rec.valid = false; rec.error = `${body?.error ?? out.status}${body?.errors ? ': ' + body.errors.join('; ') : ''}`;
          Object.assign(rec, timingsOf(body));
          $('status').textContent = `Failed (${out.status}): ${rec.error}`; finishTurn(); turn = null; return;
        }
        const entry = { question, ...body, clientMs: rec.turn_ms };
        // Register honesty, recorded per turn: every cite resolves to the echoed evidence set.
        const evIds = new Set((body.scene.evidence || []).map((e) => e.id));
        const cites = body.scene.narration.flatMap((n) => n.cites || []);
        Object.assign(rec, timingsOf(body), { layout: body.scene.layout, lines: body.scene.narration.length, model: body.model, cost_usd: costOf(entry), mode: body.mode || rec.mode, evidence_lib: body.grounding?.lib ?? rec.evidence_lib, evidence_vs: body.grounding?.vs ?? rec.evidence_vs, cites_ok: cites.every((c) => evIds.has(c)), no_answer: !!body.scene.no_answer, grounding_ms: body.timings?.grounding_ms });
        scenes.push(entry);
        const s = body.scene;
        const earlyMatches = !!(my.early && s.narration[0]?.text === my.early.text && $('auto').checked);
        showScene(entry, { keepPlaying: earlyMatches });
        rec.scene_ms = Math.round(now() - t0); updateTurnPanel();
        if (earlyMatches) {
          setLine(0);
          if (silent) narrate(s, { from: 1 });
          else {
            // line 1 may still be fetching or playing: continue with the rest when it ends
            const rest = () => { if (turn === my) narrate(s, { from: my.early.failed ? 0 : 1 }); };
            const wait = () => { if (turn !== my) return; if (my.earlyPlay) my.earlyPlay.then((f) => f && rest()); else setTimeout(wait, 50); };
            wait();
          }
        }
        if (!$('auto').checked) finishTurn();
      } catch (err) {
        clearTimeout(lateTimer);
        if (err?.name === 'AbortError') return;
        if (turn === my) { rec.valid = false; rec.error = String(err?.message ?? err); $('status').textContent = `Error: ${rec.error}`; finishTurn(); turn = null; if (!silent) playFiller(LOST); }
      } finally { $('send').disabled = false; }
    }
    const timingsOf = (b) => ({ worker_ms: b?.timings?.total_ms, grounding_ms: b?.timings?.grounding_ms, model_ms: b?.timings?.model_ms, tool_ms: b?.timings?.tool_ms, steps: b?.timings?.steps, first_line_worker_ms: b?.timings?.first_line_ms ?? undefined, tools: (b?.tool_calls || []).map((t) => t.name).join('+'), tokens_in: b?.usage?.input, tokens_out: b?.usage?.output, tokens_cached: b?.usage?.cache_read });

    $('ask').addEventListener('submit', (e) => { e.preventDefault(); ask($('q').value); });
    $('back').addEventListener('click', () => { if (scenes.length > 1) { scenes.pop(); showScene(scenes[scenes.length - 1]); } });

    // ---- voice in --------------------------------------------------------------------
    const log = createTurnLog();
    log.render($('turn-log'), $('log-summary'));
    $('csv').addEventListener('click', () => { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([log.csv()], { type: 'text/csv' })); a.download = `stage-turns-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}.csv`; a.click(); });
    $('clear-log').addEventListener('click', () => { log.clear(); log.render($('turn-log'), $('log-summary')); });

    const ENGINE_KEY = 'stage-stt-engine';
    try { $('engine').value = localStorage.getItem(ENGINE_KEY) || (WEBSPEECH_SUPPORTED ? 'webspeech' : 'vad'); } catch {}
    if (!WEBSPEECH_SUPPORTED) { $('engine').querySelector('[value=webspeech]').disabled = true; if ($('engine').value === 'webspeech') $('engine').value = 'vad'; }
    $('engine').addEventListener('change', () => { try { localStorage.setItem(ENGINE_KEY, $('engine').value); } catch {} const was = mic.active; if (was) mic.stop(); mic.setEngine($('engine').value); if (was) mic.start().catch(() => {}); });

    const overlap = (a, b) => { const A = new Set(a.toLowerCase().match(/[a-z0-9']+/g) || []); const B = b.toLowerCase().match(/[a-z0-9']+/g) || []; return B.length ? B.filter((w) => A.has(w)).length / B.length : 0; };
    const isEcho = (text) => spoken.some((s) => overlap(s, text) >= 0.6);
    const speaking = () => player.playing || (!audioEl.paused && !audioEl.ended);
    const bargeIn = (t) => speaking() && (t.match(/[a-z0-9']+/gi) || []).length >= 2 && !isEcho(t);
    const mic = createVoiceInput({
      engine: $('engine').value, sttEndpoint, getToken,
      onState: (s) => { $('vstate').textContent = s; $('vstate').dataset.state = s; $('mic').classList.toggle('on', s !== 'off'); },
      // Barge-in waits for WORDS, not sound: Web Speech's speech-start fires on the
      // avatar's own voice from the speakers, which cut lines mid-sentence (founder,
      // 2026-11-11). Playback stops only once an interim transcript is not an echo.
      onPartial: (t) => { $('q').value = t; if (bargeIn(t)) stopSpeaking('Listening…'); },
      onSpeechStart: () => {},
      onFinal: (text, meta) => {
        const m = correction(text); // "just look it up" / "treat this as a scenario" — never an echo
        if (m) { stopSpeaking(null); applyCorrection(m, meta); return; }
        if (isEcho(text)) { $('status').textContent = `Ignored (echo of my own line): “${text}”`; return; }
        ask(text, meta);
      },
      onError: (e) => { $('status').textContent = `Voice: ${e.message}`; },
    });
    $('mic').addEventListener('click', async () => {
      if (mic.active) { mic.stop(); return; }
      if (!getToken()) { $('status').textContent = 'Sign in first (owner token).'; return; }
      ensureAvatar(); prefetchAcks();
      try { await mic.start(); $('status').textContent = `Listening (${mic.engine})…`; } catch {}
    });
    if (!silent) prefetchAcks(); // fillers ready before the first question (4 short TTS calls, cached)
    if (params.get('voice') === '1') $('mic').click();

    // ---- demo: saved sample scenes (no API) --------------------------------------
    let demoIdx = -1, samples = null;
    $('demo').addEventListener('click', async () => {
      if (!samples) { samples = await (await fetch(SAMPLES_URL)).json(); }
      demoIdx = (demoIdx + 1) % samples.length;
      const entry = await (await fetch(`/lab/stage/samples/${samples[demoIdx]}`)).json();
      scenes.push(entry); showScene(entry);
      $('q').value = entry.question;
    });
    if (params.get('demo')) $('demo').click();
    window.__stage = { ask, scenes, show: (i) => showScene(scenes[i]), presence, player, mic, log, prefetchAcks, narrate: () => { const e = scenes[scenes.length - 1]; if (e) { narrT0 = now(); narrate(e.scene); } }, setLine, setMode, correction, ackUrl: (t) => ackCache.get(t), MODE_ANNOUNCE, get mode() { return { mode: sessionMode, pinned: modePinned, lastQuestion }; }, get turn() { return turn; } };
  </script>
</BaseLayout>

<style>
  .container { display: block; --st-surface: var(--color-bg); --st-border: var(--color-border); --st-muted: var(--color-fg-muted); --st-fg: var(--color-fg); --st-accent: #2a78d6; }
  .tool-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .tool-header h1 { margin: 0; font-size: 1.75rem; }
  .subtitle { color: var(--color-fg-muted); margin-top: 0.25rem; }
  .muted { color: var(--color-fg-muted); } .small { font-size: 0.85rem; }
  .ask { display: flex; gap: 0.5rem; margin: 0.75rem 0 1rem; flex-wrap: wrap; align-items: center; }
  .ask input, .ask select { font: inherit; padding: 0.55rem 0.75rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-bg); color: var(--color-fg); }
  .ask input { flex: 1 1 320px; }
  .check { font-size: 0.85rem; color: var(--color-fg-muted); display: inline-flex; gap: 0.3rem; align-items: center; }
  button, .action { font: inherit; padding: 0.5rem 0.9rem; border-radius: 0.5rem; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-fg); cursor: pointer; text-decoration: none; }
  button.primary { background: var(--color-fg); color: var(--color-bg); border-color: var(--color-fg); }
  button:disabled { opacity: 0.5; cursor: default; }
  button.on { background: #2a78d6; color: #fff; border-color: #2a78d6; }
  .small-btn { padding: 0.25rem 0.6rem; font-size: 0.8rem; }
  .row-btns { display: inline-flex; gap: 0.4rem; }
  .pill { font-size: 0.75rem; border-radius: 999px; padding: 0.15rem 0.6rem; border: 1px solid var(--color-border); color: var(--color-fg-muted); }
  .pill[data-state="listening"] { background: #1baf7a; color: #fff; border-color: #1baf7a; }
  .pill[data-state="processing"], .pill[data-state="starting"] { background: #eda100; color: #fff; border-color: #eda100; }
  .stage { position: relative; border: 1px solid var(--color-border); border-radius: 1rem; padding: 1rem 1.25rem; min-height: 360px; display: grid; gap: 0.75rem; background: color-mix(in srgb, var(--color-bg) 92%, var(--color-fg)); overflow: hidden; }
  .stage-title { display: flex; align-items: center; gap: 0.75rem; }
  .stage-title h2 { margin: 0; font-size: 1.35rem; }
  .chip { font-size: 0.75rem; border: 1px solid var(--color-border); border-radius: 999px; padding: 0.1rem 0.6rem; color: var(--color-fg-muted); }
  .stage-body { display: grid; grid-template-columns: 1fr 180px; gap: 1rem; align-items: start; }
  .stage[data-size="l"] .stage-body { grid-template-columns: 1fr 250px; }
  .stage[data-size="s"] .stage-body { grid-template-columns: 1fr 130px; }
  .layout { min-width: 0; }
  .avatar-home { min-height: 200px; }
  .actions, .followups { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip-btn { border-radius: 999px; font-size: 0.85rem; padding: 0.35rem 0.8rem; }
  .panel { border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1rem; margin-top: 1rem; }
  .panel h3 { margin: 0 0 0.5rem; font-size: 1rem; }
  .track-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
  .narration { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.35rem; }
  /* Mode switch + chips */
  .mode-switch { display: inline-flex; align-items: center; gap: 0; border: 1px solid var(--color-border); border-radius: 999px; overflow: hidden; }
  .mode-switch .mode { border: 0; border-radius: 0; padding: 0.35rem 0.75rem; font-size: 0.85rem; }
  .mode-switch .mode.on { background: #2a78d6; color: #fff; }
  .mode-switch[data-mode="solutioning"] .mode.on { background: #7a3fb3; }
  .mode-switch .pin { padding: 0 0.45rem; font-size: 0.8rem; }
  .mode-chip[data-mode="solutioning"] { border-color: #7a3fb3; color: #7a3fb3; }
  .mode-chip[data-mode="lookup"] { border-color: #2a78d6; color: #2a78d6; }
  /* Sources strip (container; the chips are global rules below) */
  .sources { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; font-size: 0.8rem; border-top: 1px dashed var(--color-border); padding-top: 0.5rem; }
  .kv { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; margin: 0; }
  .kv dt { color: var(--color-fg-muted); } .kv dd { margin: 0; font-variant-numeric: tabular-nums; }
  .scroll-x { overflow-x: auto; }
  @media (max-width: 720px) { .stage-body, .stage[data-size] .stage-body { grid-template-columns: 1fr; } .avatar-home { min-height: 150px; } }
</style>

<!-- Elements the page CREATES (narration lines, actions, follow-ups, source
     chips) never carry Astro's scope attribute, so their rules must be global.
     (Found while building plan 12: the current-line highlight and the action
     buttons had been unstyled since step 2.) -->
<style is:global>
  .stage .actions .action, .stage .followups .chip-btn { font: inherit; padding: 0.5rem 0.9rem; border-radius: 0.5rem; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-fg); cursor: pointer; text-decoration: none; }
  .stage .followups .chip-btn { border-radius: 999px; font-size: 0.85rem; padding: 0.35rem 0.8rem; }
  .track .narration li { cursor: pointer; padding: 0.2rem 0.4rem; border-radius: 0.4rem; }
  .track .narration li.current { background: color-mix(in srgb, #2a78d6 14%, transparent); }
  .track .narration li.early { font-style: italic; }
  /* Registers (plan 12): inference = "my read" in a second style; evidence lines carry their cites. */
  .track .narration li.inference { color: color-mix(in srgb, var(--color-fg) 78%, var(--color-fg-muted)); border-left: 3px solid #c9a227; padding-left: 0.6rem; }
  .track .narration li.inference::before { content: 'my read · '; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: #a4841a; }
  .track .narration li.evidence { border-left: 3px solid #2a78d6; padding-left: 0.6rem; }
  .track .narration .cites { margin-left: 0.5rem; font-size: 0.7rem; color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }
  .stage .sources .src-label { color: var(--color-fg-muted); margin-right: 0.2rem; }
  .stage .sources .src { border: 1px solid var(--color-border); border-radius: 999px; padding: 0.15rem 0.6rem; text-decoration: none; color: var(--color-fg); }
