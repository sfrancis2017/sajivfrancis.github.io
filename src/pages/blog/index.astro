---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import WriterLauncher from '@/components/WriterLauncher.astro';
import { getCollection } from 'astro:content';
import { buildPostUrl, formatDate } from '@/lib/utils';
import { categoryLabel } from '@/lib/categories';

// Section teaser — paste the CDN URL from the video pipeline here (slug: blog).
const heroVideo = 'https://sajiv-videos.sfo3.cdn.digitaloceanspaces.com/videos/blog/1781661585835.mp4';

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Current writing is grouped by theme; legacy posts (early projects) live in
// a collapsed archive at the bottom so the editorial work reads as one body.
const current = all.filter((p) => !p.data.legacy);
const archive = all.filter((p) => p.data.legacy);

const THEME_ORDER = [
  'strategy',
  'architecture',
  'ai',
  'sap',
  'finance',
  'software-engineering',
  'reference',
] as const;

const themes = THEME_ORDER.map((value) => ({
  value,
  label: categoryLabel(value),
  posts: current.filter((p) => p.data.category === value),
})).filter((t) => t.posts.length > 0);

const uncategorized = current.filter((p) => !p.data.category);

// Pre-compute reading time per post (200 wpm). Same formula as the
// individual post pages so the number on the index matches what the
// reader will see when they open the post.
const readingTimes = new Map<string, number>(
  all.map((p) => {
    const words = p.body.split(/\s+/).filter(Boolean).length;
    return [p.id, Math.max(1, Math.round(words / 200))];
  }),
);
---

<BaseLayout
  title="Writing"
  description="Essays and articles on enterprise architecture, AI, and the future of practice."
>
  <HeroVideo src={heroVideo} class="max-w-3xl mb-8" />

  <header class="mb-12 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-4xl font-semibold tracking-tight">Writing</h1>
      <p class="mt-3 text-[var(--color-fg-muted)]">
        Essays and articles on enterprise architecture, AI, and the future of
        practice. <a href="/rss.xml" class="underline">RSS</a>.
      </p>
    </div>
    <WriterLauncher />
  </header>

  {
    current.length === 0 ? (
      <p class="text-[var(--color-fg-muted)]">No posts yet.</p>
    ) : (
      <div class="space-y-16">
        {themes.map((theme) => (
          <section>
            <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] border-b border-[var(--color-border)] pb-3 mb-8">
              {theme.label}
            </h2>
            <ul class="space-y-12">
              {theme.posts.map((post) => (
                <li class="border-b border-[var(--color-border)] pb-12 last:border-b-0 last:pb-0">
                  <article class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-6">
                    {post.data.coverImage && (
                      <a href={buildPostUrl(post)} class="block">
                        <img
                          src={post.data.coverImage}
                          alt={post.data.coverAlt ?? ''}
                          loading="lazy"
                          class="w-full sm:w-[200px] aspect-[3/2] object-cover rounded-md border border-[var(--color-border)]"
                        />
                      </a>
                    )}
                    <div class={post.data.coverImage ? '' : 'sm:col-span-2'}>
                      <p class="text-sm text-[var(--color-fg-subtle)] uppercase tracking-wider">
                        {formatDate(post.data.pubDate)}
                        <span aria-hidden="true"> · </span>
                        <span>{readingTimes.get(post.id)} min read</span>
                        {post.data.publishMode === 'venue-first' && post.data.venueName && (
                          <span class="ml-2 normal-case tracking-normal">
                            · Originally published in {post.data.venueName}
                          </span>
                        )}
                      </p>
                      <h3 class="mt-2 text-2xl font-semibold tracking-tight">
                        <a href={buildPostUrl(post)} class="text-[var(--color-fg)] no-underline hover:underline">
                          {post.data.title}
                        </a>
                      </h3>
                      {post.data.subtitle && (
                        <p class="mt-1 text-base text-[var(--color-fg-muted)] italic">
                          {post.data.subtitle}
                        </p>
                      )}
                      <p class="mt-2 text-[var(--color-fg-muted)]">{post.data.description}</p>
                      {post.data.tags.length > 0 && (
                        <ul class="mt-3 flex flex-wrap gap-2 text-xs text-[var(--color-fg-subtle)]">
                          {post.data.tags.slice(0, 6).map((tag) => (
                            <li class="px-2 py-0.5 border border-[var(--color-border)] rounded-sm">
                              {tag}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))}

        {uncategorized.length > 0 && (
          <section>
            <h2 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] border-b border-[var(--color-border)] pb-3 mb-8">
              More
            </h2>
            <ul class="space-y-6">
              {uncategorized.map((post) => (
                <li>
                  <a href={buildPostUrl(post)} class="text-[var(--color-fg)] no-underline hover:underline">
                    {post.data.title}
                  </a>
                  <span class="text-sm text-[var(--color-fg-subtle)] ml-2">
                    {formatDate(post.data.pubDate)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {archive.length > 0 && (
          <details class="pt-4 border-t border-[var(--color-border)]">
            <summary class="cursor-pointer text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)]">
              Archive: earlier projects ({archive.length})
            </summary>
            <ul class="mt-6 space-y-4">
              {archive.map((post) => (
                <li class="flex items-baseline justify-between gap-4">
                  <span>
                    <a
                      href={buildPostUrl(post)}
                      class="text-[var(--color-fg-muted)] no-underline hover:underline"
                    >
                      {post.data.title}
                    </a>
                    {post.data.subtitle && (
                      <span class="text-sm text-[var(--color-fg-subtle)]">
                        {' '}· {post.data.subtitle}
                      </span>
                    )}
                  </span>
                  <time class="text-sm text-[var(--color-fg-subtle)] tabular-nums shrink-0">
                    {formatDate(post.data.pubDate, { year: 'numeric' })}
                  </time>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )
  }
</BaseLayout>
